{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "baseUrl", "existingSecret"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository", "tag"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "baseUrl": { "type": "string", "format": "uri", "pattern": "^https://", "minLength": 1 },
    "existingSecret": { "type": "string", "minLength": 1 },
    "existingSecretKey": { "type": "string", "minLength": 1 },
    "persistence": {
      "type": "object",
      "properties": {
        "existingClaim": { "type": "string" },
        "size": { "type": "string", "minLength": 1 },
        "accessMode": { "type": "string", "const": "ReadWriteOnce" },
        "storageClass": { "type": "string" }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "hosts": { "type": "array" },
        "tls": { "type": "array" }
      }
    }
  }
}
